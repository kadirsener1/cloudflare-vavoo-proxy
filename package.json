{
  "name": "cloudflare-vavoo-proxy",
  "version": "2.0.0",
  "description": "Cloudflare Worker proxy for Vavoo streams with R2 persistent cache, low-latency HLS and IPv4 fallback",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "r2:list": "wrangler r2 object list vavoo-stream-cache",
    "r2:clean": "wrangler r2 object delete vavoo-stream-cache --recursive"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cloudflare-worker",
    "vavoo",
    "hls",
    "r2",
    "proxy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kadirsener1/cloudflare-vavoo-proxy.git"
  },
  "license": "MIT"
}
